# Gốc HTTP(S) của backend, không có /api (giống web: VITE_API_URL)
# Mặc định trong app đã trỏ Render; chỉ cần file này khi dev local:
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3000
EXPO_PUBLIC_API_URL=https://tubep-backend.onrender.com

# URL ứng dụng web (SPA) — để mở Báo giá / Dự án trong trình duyệt từ app
# EXPO_PUBLIC_WEB_APP_URL=https://your-frontend.example.com
