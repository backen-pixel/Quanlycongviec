{
  "expo": {
    "name": "TuBep CRM",
    "slug": "crm-mobile",
    "version": "1.3.25",
    "orientation": "portrait",
    "icon": "./assets/app-icon.jpg",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF2F8"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Ứng dụng cần micro để ghi âm tư vấn và lưu vào lead/deal trên CRM.",
        "NSCameraUsageDescription": "Ứng dụng cần camera để chụp ảnh gửi trong chat nhóm CRM.",
        "NSPhotoLibraryUsageDescription": "Ứng dụng cần truy cập thư viện ảnh để đính kèm trong chat nhóm CRM.",
        "NSLocationWhenInUseUsageDescription": "Ứng dụng cần vị trí khi đang dùng để hiển thị địa chỉ đăng nhập thiết bị trong trang Đang hoạt động."
      }
    },
    "android": {
      "package": "vn.tubeppro.crmobile",
      "versionCode": 41,
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_PHONE_STATE",
        "android.permission.READ_CALL_LOG",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.NEARBY_WIFI_DEVICES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.jpg",
        "backgroundColor": "#EEF2F8"
      },
      "usesCleartextTraffic": true,
      "edgeToEdgeEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/app-icon.jpg"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#0068FF",
          "defaultChannel": "crm_chat"
        }
      ],
      "./plugins/withIncomingCallAndroid.js",
      "./plugins/withGoogleServices.js"
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    },
    "owner": "tubeppro"
  }
}
