    "db:fix-backup-grants": "node scripts/fix-backup-schema-grants.js",
    "storage:sync-backup": "node scripts/sync-storage-to-backup.js",
    "storage:sync-backup:dry": "node scripts/sync-storage-to-backup.js --dry-run",
    "ota:publish": "node scripts/publish-ota.js",
    "test:cache": "node tests/response-cache-smoke.js",
    "test:tenant": "node tests/tenant-isolation-smoke.js",
    "test:crm-split": "node tests/crm-split-50-cases.js",
    "test:crm-split:b": "node tests/crm-split-50-cases-b.js",
    "test:crm-split:all": "node tests/crm-split-50-cases.js && node tests/crm-split-50-cases-b.js",
