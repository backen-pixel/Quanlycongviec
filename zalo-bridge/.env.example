# ── CRM ──────────────────────────────────────────────────────────
# CRM chạy trên VPS, cổng chạy ở máy công ty → phải là https://
# Chỉ khi test với CRM trên chính máy này mới được dùng http://localhost:4000
CRM_BASE_URL=https://erp.vanphuthanh.net

# Khoá của MÁY này (zalo_gateways.gateway_token), không phải của từng tài khoản
GATEWAY_TOKEN=thay-bang-khoa-that

# ── Zalo ─────────────────────────────────────────────────────────
BRIDGE_TRANSPORT=zca

# Số tài khoản trên một tiến trình con. Đo được: nền 79 MB + ~20 MB mỗi phiên.
# Tăng lên thì tiết kiệm bộ nhớ nhưng một lỗi kéo theo nhiều tài khoản hơn.
ACCOUNTS_PER_WORKER=4

# ── Nhịp (ms) ────────────────────────────────────────────────────
OUTBOX_POLL_MS=3000
ALLOWLIST_REFRESH_MS=60000
STATUS_REPORT_MS=30000
SPOOL_RETRY_MS=15000
REGISTRY_SYNC_MS=60000
COMMAND_POLL_MS=10000

# ── Trang quản trị ───────────────────────────────────────────────
# Mặc định chỉ loopback. Xem được trang này = xem được mã QR = đăng nhập được
# vào tài khoản Zalo. Chỉ đổi thành 0.0.0.0 nếu mạng văn phòng đủ tin cậy.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8787
