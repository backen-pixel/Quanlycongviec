  classDef crm fill:#EEEDFE,stroke:#7F77DD,stroke-width:1px,color:#26215C
  classDef csdl fill:#E6F1FB,stroke:#378ADD,stroke-width:1px,color:#042C53
  classDef kho fill:#FAEEDA,stroke:#BA7517,stroke-width:1px,color:#412402
  classDef nguoi fill:#FBEAF0,stroke:#D4537E,stroke-width:1px,color:#4B1528

  class DT,ZS,CDN ngoai
  class SUP,ZCA,ECHO,LOC,OUTL,LNKL may
  class SES,SPO,CFG tep
  class BR,ING,SEND,COPY,SERVE,SIO crm
  class GW,ACC,CON,MSG,OBX,PEND,LNK,CMD,LEAD csdl
