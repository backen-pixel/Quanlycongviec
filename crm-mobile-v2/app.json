{
  "expo": {
    "name": "CRM Mobile",
    "slug": "crm-mobile-v2",
    "scheme": "crmv2",
    "version": "2.0.89",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#0B0F17",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F17"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Ứng dụng cần micro để gọi thoại và ghi âm cuộc gọi trên CRM.",
        "NSCameraUsageDescription": "Ứng dụng cần camera cho cuộc gọi video và quét mã QR đăng nhập."
      }
    },
    "android": {
      "package": "vn.tubeppro.crmobilev2",
      "versionCode": 90,
      "edgeToEdgeEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F17"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_PHONE_STATE",
        "android.permission.READ_CALL_LOG",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.CAMERA",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.WAKE_LOCK",
        "android.permission.DISABLE_KEYGUARD",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_SPECIAL_USE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép camera để quét mã QR đăng nhập và gọi video."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Ứng dụng cần truy cập media để đọc file ghi âm cuộc gọi trên máy.",
          "savePhotosPermission": "Ứng dụng cần lưu file ghi âm.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-background-task",
      [
        "expo-notifications",
        {
          "color": "#2F6BFF"
        }
      ],
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "disableAndroid": true
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Cho phép camera cho cuộc gọi video.",
          "microphonePermission": "Cho phép micro cho cuộc gọi thoại."
        }
      ],
      "./plugins/withIncomingCallAndroid.js",
      "./plugins/withArm64Apk.js",
      [
        "../mobile-shared/share-intent/plugins/withAndroidShareIntentFilters",
        {
          "mimeTypes": [
            "audio/*",
            "application/octet-stream",
            "video/mp4",
            "video/*",
            "*/*"
          ]
        }
      ]
    ]
  }
}
