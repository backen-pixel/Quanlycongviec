{
  "expo": {
    "name": "CRM Mobile",
    "slug": "crm-mobile-v2",
    "version": "2.0.11",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0B0F17",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B0F17"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Ứng dụng cần micro để ghi âm cuộc gọi và lưu vào lead/deal trên CRM."
      }
    },
    "android": {
      "package": "vn.tubeppro.crmobilev2",
      "versionCode": 12,
      "edgeToEdgeEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
