<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/call_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#0E1626">

  <!-- ===================== MÀN HÌNH CUỘC GỌI ĐẾN ===================== -->
  <LinearLayout
    android:id="@+id/incoming_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="28dp"
    android:paddingTop="64dp"
    android:paddingBottom="40dp">

    <TextView
      android:id="@+id/incoming_header"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:gravity="center"
      android:text="Messenger · Cuộc gọi đến"
      android:textColor="#8A93A5"
      android:textSize="14sp" />

    <FrameLayout
      android:layout_width="160dp"
      android:layout_height="160dp"
      android:layout_marginTop="44dp">

      <View
        android:id="@+id/pulse_ring_3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/call_pulse_ring" />

      <View
        android:id="@+id/pulse_ring_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="14dp"
        android:background="@drawable/call_pulse_ring" />

      <View
        android:id="@+id/pulse_ring_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="28dp"
        android:background="@drawable/call_pulse_ring" />

      <TextView
        android:id="@+id/avatar_text"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:layout_gravity="center"
        android:background="@drawable/call_avatar_pink"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        android:textStyle="bold" />
    </FrameLayout>

    <TextView
      android:id="@+id/name_text"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="32dp"
      android:gravity="center"
      android:textColor="#FFFFFF"
      android:textSize="28sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/subtitle_text"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:textColor="#94A3B8"
      android:textSize="16sp" />

    <!-- Nhắc sau + Nhắn tin -->
    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="32dp"
      android:gravity="center"
      android:orientation="horizontal">

      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="22dp"
        android:gravity="center"
        android:orientation="vertical">

        <ImageButton
          android:id="@+id/btn_remind"
          android:layout_width="52dp"
          android:layout_height="52dp"
          android:background="@drawable/call_control_circle"
          android:contentDescription="Nhắc sau"
          android:padding="14dp"
          android:scaleType="fitCenter"
          android:src="@android:drawable/ic_lock_idle_alarm"
          android:tint="#CBD5E1" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:text="Nhắc sau"
          android:textColor="#8A93A5"
          android:textSize="13sp" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="22dp"
        android:gravity="center"
        android:orientation="vertical">

        <ImageButton
          android:id="@+id/btn_message"
          android:layout_width="52dp"
          android:layout_height="52dp"
          android:background="@drawable/call_control_circle"
          android:contentDescription="Nhắn tin"
          android:padding="14dp"
          android:scaleType="fitCenter"
          android:src="@android:drawable/sym_action_chat"
          android:tint="#CBD5E1" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:text="Nhắn tin"
          android:textColor="#8A93A5"
          android:textSize="13sp" />
      </LinearLayout>
    </LinearLayout>

    <View
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1" />

    <!-- Từ chối · Vuốt nhắn · Nhận -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="bottom"
      android:orientation="horizontal">

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageButton
          android:id="@+id/btn_decline"
          android:layout_width="64dp"
          android:layout_height="64dp"
          android:background="@drawable/call_btn_decline_circle"
          android:contentDescription="Từ chối"
          android:padding="18dp"
          android:scaleType="fitCenter"
          android:src="@android:drawable/sym_action_call"
          android:rotation="135"
          android:tint="#FFFFFF" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:text="Từ chối"
          android:textColor="#CBD5E1"
          android:textSize="14sp" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="56dp"
          android:background="@drawable/call_swipe_pill_bg"
          android:gravity="center"
          android:orientation="horizontal"
          android:paddingHorizontal="18dp">

          <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@android:drawable/sym_action_call"
            android:tint="#34D399" />

          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Vuốt\nnhắn"
            android:textColor="#E2E8F0"
            android:textSize="12sp" />
        </LinearLayout>
      </LinearLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageButton
          android:id="@+id/btn_accept"
          android:layout_width="64dp"
          android:layout_height="64dp"
          android:background="@drawable/call_btn_answer_circle"
          android:contentDescription="Nhận"
          android:padding="17dp"
          android:scaleType="fitCenter"
          android:src="@android:drawable/sym_action_call"
          android:tint="#FFFFFF" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:text="Nhận"
          android:textColor="#CBD5E1"
          android:textSize="14sp" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>

  <!-- ===================== MÀN HÌNH ĐANG GỌI ===================== -->
  <LinearLayout
    android:id="@+id/incall_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="56dp"
    android:paddingBottom="40dp"
    android:visibility="gone">

    <TextView
      android:id="@+id/incall_header"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Đang gọi qua Messenger"
      android:textColor="#8A93A5"
      android:textSize="14sp" />

    <TextView
      android:id="@+id/incall_name"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:textColor="#FFFFFF"
      android:textSize="24sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/incall_timer"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:textColor="#2DD4BF"
      android:textSize="16sp" />

    <!-- Thẻ người tham gia -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="28dp"
      android:background="@drawable/call_card_bg"
      android:orientation="horizontal"
      android:padding="20dp">

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
          android:id="@+id/peer_avatar"
          android:layout_width="64dp"
          android:layout_height="64dp"
          android:background="@drawable/call_avatar_pink"
          android:gravity="center"
          android:textColor="#FFFFFF"
          android:textSize="24sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/peer_name"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:textColor="#E2E8F0"
          android:textSize="14sp" />

        <LinearLayout
          android:id="@+id/waveform_row"
          android:layout_width="wrap_content"
          android:layout_height="22dp"
          android:layout_marginTop="8dp"
          android:gravity="bottom|center_horizontal"
          android:orientation="horizontal" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
          android:id="@+id/self_avatar"
          android:layout_width="64dp"
          android:layout_height="64dp"
          android:background="@drawable/call_avatar_purple"
          android:gravity="center"
          android:text="B"
          android:textColor="#FFFFFF"
          android:textSize="24sp"
          android:textStyle="bold" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:text="Bạn"
          android:textColor="#E2E8F0"
          android:textSize="14sp" />

        <TextView
          android:id="@+id/self_mic_status"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:text=""
          android:textColor="#8A93A5"
          android:textSize="12sp" />
      </LinearLayout>
    </LinearLayout>

    <View
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1" />

    <!-- Lưới điều khiển -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageButton
          android:id="@+id/btn_mute_secondary"
          android:layout_width="64dp"
          android:layout_height="64dp"
          android:background="@drawable/call_control_circle"
          android:contentDescription="Tắt mic"
          android:padding="17dp"
          android:scaleType="fitCenter"
          android:src="@android:drawable/ic_btn_speak_now"
          android:tint="#FFFFFF" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:text="Tắt mic"
          android:textColor="#8A93A5"
          android:textSize="13sp" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageButton
          android:id="@+id/btn_speaker"
          android:layout_width="64dp"
          android:layout_height="64dp"
          android:background="@drawable/call_control_circle"
          android:contentDescription="Loa ngoài"
          android:padding="17dp"
          android:scaleType="fitCenter"
          android:src="@android:drawable/ic_lock_silent_mode_off"
          android:tint="#FFFFFF" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:text="Loa ngoài"
          android:textColor="#8A93A5"
          android:textSize="13sp" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageButton
          android:id="@+id/btn_add_people"
          android:layout_width="64dp"
          android:layout_height="64dp"
          android:background="@drawable/call_control_circle"
          android:contentDescription="Thêm người"
          android:padding="16dp"
          android:scaleType="fitCenter"
          android:src="@android:drawable/ic_menu_add"
          android:tint="#FFFFFF" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:text="Thêm người"
          android:textColor="#8A93A5"
          android:textSize="13sp" />
      </LinearLayout>
    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:orientation="horizontal">

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageButton
          android:id="@+id/btn_keypad"
          android:layout_width="64dp"
          android:layout_height="64dp"
          android:background="@drawable/call_control_circle"
          android:contentDescription="Bàn phím"
          android:padding="17dp"
          android:scaleType="fitCenter"
          android:src="@android:drawable/ic_dialog_dialer"
          android:tint="#FFFFFF" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:text="Bàn phím"
          android:textColor="#8A93A5"
          android:textSize="13sp" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageButton
          android:id="@+id/btn_video"
          android:layout_width="64dp"
          android:layout_height="64dp"
          android:background="@drawable/call_control_circle"
          android:contentDescription="Video"
          android:padding="17dp"
          android:scaleType="fitCenter"
          android:src="@android:drawable/ic_menu_camera"
          android:tint="#FFFFFF" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:text="Video"
          android:textColor="#8A93A5"
          android:textSize="13sp" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageButton
          android:id="@+id/btn_minimize"
          android:layout_width="64dp"
          android:layout_height="64dp"
          android:background="@drawable/call_control_circle"
          android:contentDescription="Thu nhỏ"
          android:padding="17dp"
          android:scaleType="fitCenter"
          android:src="@android:drawable/ic_menu_set_as"
          android:tint="#FFFFFF" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:text="Thu nhỏ"
          android:textColor="#8A93A5"
          android:textSize="13sp" />
      </LinearLayout>
    </LinearLayout>

    <ImageButton
      android:id="@+id/btn_end"
      android:layout_width="68dp"
      android:layout_height="68dp"
      android:layout_marginTop="28dp"
      android:background="@drawable/call_btn_end_circle"
      android:contentDescription="Kết thúc"
      android:padding="18dp"
      android:scaleType="fitCenter"
      android:src="@android:drawable/sym_action_call"
      android:rotation="135"
      android:tint="#FFFFFF" />
  </LinearLayout>
</FrameLayout>

