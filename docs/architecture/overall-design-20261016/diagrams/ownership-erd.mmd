%% DESIGN_PROPOSAL / NOT_LIVE. Logical ownership, not SQL migration.
%% Legacy physical mapping and single writer are in CONTRACTS.md section2 / INVENTORY.md.
%% Value objects and reference edges below do not require new physical tables or FK columns.
%% SERVICE_CASE.party_id + envelope company resolve exactly one authorized PARTY_SCOPE.
%% Service intake permits null order/project/policy/context; warranty adjudication requires verified policy+context.
%% DECISION requires one-or-more fact/rule refs; consent refs may be empty only for NOT_APPLICABLE with reason.
%% COMMAND.precondition kind is ABSENT, MATCH_REVISION or READ_ONLY; READ_ONLY never authorizes an effect.
%% RECEIPT phase determines required refs: DURABLE_ACCEPTANCE requires intake; dispatch/effect requires command.
erDiagram
  TENANT ||--o{ COMPANY : contains
  COMPANY ||--o{ MEMBERSHIP : scopes
  PARTY ||--o{ PARTY_SCOPE : has
  COMPANY ||--o{ PARTY_SCOPE : authorizes
  PARTY_SCOPE ||--o{ NEED : requests
  NEED ||--o{ HANDOFF : assigned
  NEED ||--o{ QUOTE : priced
  QUOTE ||--o{ CUSTOMER_ACCEPTANCE : exact_revision
  CUSTOMER_ACCEPTANCE ||--o{ ORDER : authorizes
  ORDER ||--o{ PROJECT : execution_units
  PROJECT ||--o{ WORK_ITEM : schedules
  NEED ||--o{ WORK_ITEM : presales
  ORDER ||--o{ PAYMENT : reports
  PAYMENT ||--o{ REFUND : reverses
  PARTY_SCOPE ||--o{ SERVICE_CASE : mandatory_party_in_scope
  ORDER |o--o{ SERVICE_CASE : optional_order
  PROJECT |o--o{ SERVICE_CASE : optional_project
  PARTY_SCOPE ||--o{ CONSENT_EVENT : purpose_channel
  MARKETING_PLAN ||--o{ CAMPAIGN_PLAN : defines
  MARKETING_PLAN ||--o{ CONTENT : commissions
  CONTENT ||--o{ ASSET_RIGHTS : cites
  CAMPAIGN_PLAN ||--o{ NATIVE_BINDING : maps
  NATIVE_BINDING ||--o{ TOUCHPOINT : observes
  NEED ||--o{ ATTRIBUTION : credited
  TOUCHPOINT ||--o{ ATTRIBUTION : evidence
  FACT }|--o{ DECISION : one_or_more_fact_refs
  RULE }|--o{ DECISION : one_or_more_rule_versions
  CONSENT_EVENT }o--o{ DECISION : conditional_consent_refs
  DECISION ||--o| APPROVAL : exact_digest
  DECISION ||--o{ COMMAND : authorizes
  COMMAND ||--o{ CLAIM : fenced_attempts
  COMMAND |o--o{ RECEIPT : nullable_command_phase_dependent
  INTAKE_EVENT |o--o{ RECEIPT : nullable_intake_phase_dependent
  BUDGET ||--o{ RESERVATION : reserves
  COMMAND ||--o| RESERVATION : exposure
  RESERVATION ||--o{ USAGE : settles
  WORK_ITEM ||--o{ AI_TASK : delegates
  AI_TASK ||--o{ AI_RUN : attempts
  AI_RUN ||--o{ RUNTIME_MAPPING : native_ids
  AI_RUN ||--o{ RESERVATION : per_call
  EXPECTATION ||--o{ OUTCOME : measured
  FACT }|--o{ OUTCOME : source_revisions
  OUTCOME ||--o{ ADJUSTMENT : proposes
  RULE ||--o{ ADJUSTMENT : old_version
